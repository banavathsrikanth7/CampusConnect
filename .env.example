# GEMINI_API_KEY: Optional auxiliary Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SARVAM_API_KEY: Required for Sarvam AI speech-to-text, translation, and structured LLM analysis.
# Obtain from https://dashboard.sarvam.ai/ and configure in AI Studio Secrets or environment.
SARVAM_API_KEY="your_sarvam_api_key_here"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ADMIN_SECRET_KEY: Passkey or token for administrative operations and management access.
ADMIN_SECRET_KEY="campus-admin-passkey-2026"

